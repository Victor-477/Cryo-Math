// ============================================================
//  Cryo-Math — biblioteca de cálculos matemáticos para Cryo
//
//  Uso (com namespace, recomendado):
//
//      import "@cryo_math/math.cryo" as m;     // via cryo.toml
//      import "caminho/para/math.cryo" as m;   // ou por caminho relativo
//
//      print(m::sqrt(2.0));
//      print(m::sin(m::PI / 6.0));
//
//  Tudo é escrito em Cryo puro: a biblioteca não depende de nenhum
//  builtin matemático (sqrt, pow, floor...), por isso se comporta da
//  mesma forma em todos os backends (pyro, go, node, c).
//
//  Erros de domínio (raiz de negativo, log de zero, divisão por zero,
//  fatorial grande demais...) são lançados com `throw` e podem ser
//  capturados com `try { ... } catch (string e) { ... }`. Toda mensagem
//  começa com "[cryo-math]".
// ============================================================


// ── Constantes ───────────────────────────────────────────────

pub const number PI      = 3.141592653589793
pub const number TAU     = 6.283185307179586
pub const number HALF_PI = 1.5707963267948966
pub const number E       = 2.718281828459045
pub const number PHI     = 1.618033988749895
pub const number SQRT2   = 1.4142135623730951
pub const number LN2     = 0.6931471805599453
pub const number LN10    = 2.302585092994046

// Tolerância padrão usada por is_close().
pub const number EPSILON = 0.000000001

// A partir de 2^52 todo `number` (double) já é inteiro.
const number _INT_LIMIT = 4503599627370496.0

// Maior inteiro cujo fatorial cabe num int de 64 bits.
const int _MAX_FACTORIAL = 20


fn _fail(string msg) -> number ={
    throw("[cryo-math] " + msg);
}


// ── Básico ───────────────────────────────────────────────────

pub fn abs(number x) -> number ={
    if (x < 0.0) { return -x; }
    return x;
}

pub fn iabs(int n) -> int ={
    if (n < 0) { return -n; }
    return n;
}

// -1, 0 ou 1.
pub fn sign(number x) -> number ={
    if (x > 0.0) { return 1.0; }
    if (x < 0.0) { return -1.0; }
    return 0.0;
}

pub fn min(number a, number b) -> number ={
    if (a < b) { return a; }
    return b;
}

pub fn max(number a, number b) -> number ={
    if (a > b) { return a; }
    return b;
}

// Restringe x ao intervalo [lo, hi].
pub fn clamp(number x, number lo, number hi) -> number ={
    if (lo > hi) { return _fail("clamp: lo > hi"); }
    if (x < lo) { return lo; }
    if (x > hi) { return hi; }
    return x;
}

// Parte inteira, descartando a fração (em direção a zero).
pub fn trunc(number x) -> number ={
    if (abs(x) >= _INT_LIMIT) { return x; }
    return to_number(to_int(x));
}

pub fn floor(number x) -> number ={
    number t = trunc(x);
    if (t > x) { return t - 1.0; }
    return t;
}

pub fn ceil(number x) -> number ={
    number t = trunc(x);
    if (t < x) { return t + 1.0; }
    return t;
}

// Arredonda para o inteiro mais próximo; .5 se afasta de zero.
pub fn round(number x) -> number ={
    if (x < 0.0) { return -floor(-x + 0.5); }
    return floor(x + 0.5);
}

// Arredonda para `places` casas decimais.
pub fn round_to(number x, int places) -> number ={
    number f = ipow(10.0, places);
    return round(x * f) / f;
}

// Parte fracionária: x - trunc(x).
pub fn frac(number x) -> number ={
    return x - trunc(x);
}

// Resto da divisão com o sinal do dividendo (como fmod do C).
pub fn fmod(number a, number b) -> number ={
    if (b == 0.0) { return _fail("fmod: divisao por zero"); }
    return a - trunc(a / b) * b;
}

// Resto sempre no intervalo [0, |b|).
pub fn mod(number a, number b) -> number ={
    number r = fmod(a, b);
    if (r < 0.0) { r = r + abs(b); }
    return r;
}

// Comparação de números reais com tolerância relativa/absoluta.
pub fn is_close(number a, number b, number tol) -> bool ={
    number diff = abs(a - b);
    number scale = max(1.0, max(abs(a), abs(b)));
    return diff <= tol * scale;
}

pub fn is_integer(number x) -> bool ={
    return trunc(x) == x;
}

// Interpolação linear entre a e b (t = 0 → a, t = 1 → b).
pub fn lerp(number a, number b, number t) -> number ={
    return a + (b - a) * t;
}

pub fn deg_to_rad(number deg) -> number ={
    return deg * PI / 180.0;
}

pub fn rad_to_deg(number rad) -> number ={
    return rad * 180.0 / PI;
}


// ── Potências e raízes ───────────────────────────────────────

// base^n para expoente inteiro (exponenciação por quadrados).
pub fn ipow(number base, int n) -> number ={
    if (n == 0) { return 1.0; }
    if (n < 0) {
        if (base == 0.0) { return _fail("ipow: zero elevado a expoente negativo"); }
        return 1.0 / ipow(base, -n);
    }
    number result = 1.0;
    number b = base;
    int e = n;
    while (e > 0) {
        if ((e & 1) == 1) { result = result * b; }
        b = b * b;
        e = e >> 1;
    }
    return result;
}

pub fn square(number x) -> number ={
    return x * x;
}

pub fn cube(number x) -> number ={
    return x * x * x;
}

// Raiz quadrada pelo método de Newton, com redução de escala.
pub fn sqrt(number x) -> number ={
    if (x < 0.0) { return _fail("sqrt: raiz de numero negativo"); }
    if (x == 0.0) { return 0.0; }
    // Leva y para [0.25, 4) multiplicando/dividindo por 4,
    // o que só muda o resultado por potências de 2 (exato).
    number y = x;
    number scale = 1.0;
    while (y >= 4.0) { y = y / 4.0; scale = scale * 2.0; }
    while (y < 0.25) { y = y * 4.0; scale = scale / 2.0; }
    number g = y;
    for (int i = 0; i < 60; i++) {
        number next = 0.5 * (g + y / g);
        if (next == g) { break; }
        g = next;
    }
    return g * scale;
}

// Raiz cúbica (aceita negativos).
pub fn cbrt(number x) -> number ={
    if (x == 0.0) { return 0.0; }
    number a = abs(x);
    number g = exp(ln(a) / 3.0);
    for (int i = 0; i < 4; i++) {
        g = g - (g * g * g - a) / (3.0 * g * g);
    }
    return sign(x) * g;
}

// Raiz n-ésima. Para n ímpar aceita x negativo.
pub fn nth_root(number x, int n) -> number ={
    if (n == 0) { return _fail("nth_root: indice zero"); }
    if (n < 0) { return 1.0 / nth_root(x, -n); }
    if (n == 1) { return x; }
    if (n == 2) { return sqrt(x); }
    if (x == 0.0) { return 0.0; }
    bool odd = (n & 1) == 1;
    if (x < 0.0 && !odd) { return _fail("nth_root: raiz par de numero negativo"); }
    number a = abs(x);
    number nn = to_number(n);
    number g = exp(ln(a) / nn);
    for (int i = 0; i < 4; i++) {
        g = g - (ipow(g, n) - a) / (nn * ipow(g, n - 1));
    }
    if (x < 0.0) { return -g; }
    return g;
}

pub fn hypot(number a, number b) -> number ={
    number x = abs(a);
    number y = abs(b);
    number big = max(x, y);
    if (big == 0.0) { return 0.0; }
    number small = min(x, y) / big;
    return big * sqrt(1.0 + small * small);
}

// e^x — redução x = k·ln2 + r e série de Taylor em r.
pub fn exp(number x) -> number ={
    if (x == 0.0) { return 1.0; }
    if (x > 709.782712893384) { return _fail("exp: overflow"); }
    if (x < -745.1332191019411) { return 0.0; }
    number kf = round(x / LN2);
    // Cody-Waite: ln2 = HI + LO, com HI tendo bits finais zerados para que
    // kf * HI seja exato; evita perder dígitos quando |x| é grande.
    number r = (x - kf * 0.693147180369123816490) - kf * 0.000000000190821492927058770002;
    number term = 1.0;
    number sum = 1.0;
    for (int i = 1; i < 40; i++) {
        term = term * r / to_number(i);
        sum = sum + term;
        if (abs(term) < 0.0000000000000000001) { break; }
    }
    int k = to_int(kf);
    // 2^k em dois passos para não estourar em extremos (k até ±1075).
    int half = k / 2;
    return sum * ipow(2.0, half) * ipow(2.0, k - half);
}

// Logaritmo natural — x = m·2^k com m em [√½, √2] e série de atanh.
pub fn ln(number x) -> number ={
    if (x <= 0.0) { return _fail("ln: argumento deve ser positivo"); }
    if (x == 1.0) { return 0.0; }
    number m = x;
    int k = 0;
    while (m >= 2.0) { m = m / 2.0; k++; }
    while (m < 1.0) { m = m * 2.0; k--; }
    if (m > SQRT2) { m = m / 2.0; k++; }
    number s = (m - 1.0) / (m + 1.0);
    number s2 = s * s;
    number term = s;
    number sum = 0.0;
    for (int i = 1; i < 200; i = i + 2) {
        number part = term / to_number(i);
        sum = sum + part;
        if (abs(part) < 0.0000000000000000001) { break; }
        term = term * s2;
    }
    return 2.0 * sum + to_number(k) * LN2;
}

pub fn log10(number x) -> number ={
    return ln(x) / LN10;
}

pub fn log2(number x) -> number ={
    return ln(x) / LN2;
}

// Logaritmo de x na base `base`.
pub fn log(number x, number base) -> number ={
    if (base <= 0.0 || base == 1.0) { return _fail("log: base invalida"); }
    return ln(x) / ln(base);
}

// x^y para y real.
pub fn pow(number x, number y) -> number ={
    if (y == 0.0) { return 1.0; }
    if (is_integer(y) && abs(y) < 1000000000.0) {
        return ipow(x, to_int(y));
    }
    if (x == 0.0) {
        if (y > 0.0) { return 0.0; }
        return _fail("pow: zero elevado a expoente negativo");
    }
    if (x < 0.0) { return _fail("pow: base negativa com expoente fracionario"); }
    return exp(y * ln(x));
}


// ── Trigonometria (radianos) ─────────────────────────────────

// Reduz um ângulo ao intervalo [-PI, PI].
pub fn normalize_angle(number x) -> number ={
    number r = fmod(x, TAU);
    if (r > PI) { r = r - TAU; }
    if (r < -PI) { r = r + TAU; }
    return r;
}

fn _sin_series(number x) -> number ={
    number x2 = x * x;
    number term = x;
    number sum = x;
    for (int i = 1; i < 30; i++) {
        number n = to_number(2 * i);
        term = -term * x2 / (n * (n + 1.0));
        sum = sum + term;
        if (abs(term) < 0.0000000000000000001) { break; }
    }
    return sum;
}

fn _cos_series(number x) -> number ={
    number x2 = x * x;
    number term = 1.0;
    number sum = 1.0;
    for (int i = 1; i < 30; i++) {
        number n = to_number(2 * i);
        term = -term * x2 / ((n - 1.0) * n);
        sum = sum + term;
        if (abs(term) < 0.0000000000000000001) { break; }
    }
    return sum;
}

// As séries só são usadas em [-PI/4, PI/4], onde convergem mais rápido
// e com menos erro; fora disso usa-se a identidade complementar
// sin(r) = cos(PI/2 - r). Assim sin(PI) e cos(PI/2) dão 0 exato.

pub fn sin(number x) -> number ={
    number r = normalize_angle(x);
    // sin(PI - r) = sin(r): leva r para [-PI/2, PI/2].
    if (r > HALF_PI) { r = PI - r; }
    if (r < -HALF_PI) { r = -PI - r; }
    number a = abs(r);
    if (a <= PI / 4.0) { return _sin_series(r); }
    return sign(r) * _cos_series(HALF_PI - a);
}

pub fn cos(number x) -> number ={
    number r = abs(normalize_angle(x));
    if (r <= PI / 4.0) { return _cos_series(r); }
    if (r <= 3.0 * PI / 4.0) { return _sin_series(HALF_PI - r); }
    // cos(PI - r) = -cos(r)
    return -_cos_series(PI - r);
}

pub fn tan(number x) -> number ={
    number c = cos(x);
    if (abs(c) < 0.000000000000001) { return _fail("tan: indefinida (cos = 0)"); }
    return sin(x) / c;
}

pub fn atan(number x) -> number ={
    if (x < 0.0) { return -atan(-x); }
    if (x > 1.0) { return HALF_PI - atan(1.0 / x); }
    // tan(PI/8) ≈ 0.41421: acima disso usa atan(x) = PI/4 + atan((x-1)/(x+1)).
    if (x > 0.41421356237309503) {
        return PI / 4.0 + atan((x - 1.0) / (x + 1.0));
    }
    number x2 = x * x;
    number term = x;
    number sum = 0.0;
    for (int i = 1; i < 200; i = i + 2) {
        number part = term / to_number(i);
        sum = sum + part;
        if (abs(part) < 0.0000000000000000001) { break; }
        term = -term * x2;
    }
    return sum;
}

// Ângulo do ponto (x, y) em [-PI, PI].
pub fn atan2(number y, number x) -> number ={
    if (x > 0.0) { return atan(y / x); }
    if (x < 0.0) {
        if (y >= 0.0) { return atan(y / x) + PI; }
        return atan(y / x) - PI;
    }
    if (y > 0.0) { return HALF_PI; }
    if (y < 0.0) { return -HALF_PI; }
    return 0.0;
}

pub fn asin(number x) -> number ={
    if (x < -1.0 || x > 1.0) { return _fail("asin: argumento fora de [-1, 1]"); }
    return atan2(x, sqrt(1.0 - x * x));
}

pub fn acos(number x) -> number ={
    if (x < -1.0 || x > 1.0) { return _fail("acos: argumento fora de [-1, 1]"); }
    return atan2(sqrt(1.0 - x * x), x);
}


// ── Funções hiperbólicas ─────────────────────────────────────

pub fn sinh(number x) -> number ={
    if (abs(x) < 0.5) {
        // série de Taylor evita cancelamento perto de zero
        number x2 = x * x;
        number term = x;
        number sum = x;
        for (int i = 1; i < 20; i++) {
            number n = to_number(2 * i);
            term = term * x2 / (n * (n + 1.0));
            sum = sum + term;
        }
        return sum;
    }
    number ex = exp(x);
    return (ex - 1.0 / ex) / 2.0;
}

pub fn cosh(number x) -> number ={
    number ex = exp(abs(x));
    return (ex + 1.0 / ex) / 2.0;
}

pub fn tanh(number x) -> number ={
    if (x > 20.0) { return 1.0; }
    if (x < -20.0) { return -1.0; }
    return sinh(x) / cosh(x);
}

pub fn asinh(number x) -> number ={
    number a = abs(x);
    return sign(x) * ln(a + sqrt(a * a + 1.0));
}

pub fn acosh(number x) -> number ={
    if (x < 1.0) { return _fail("acosh: argumento deve ser >= 1"); }
    return ln(x + sqrt(x * x - 1.0));
}

pub fn atanh(number x) -> number ={
    if (x <= -1.0 || x >= 1.0) { return _fail("atanh: argumento fora de (-1, 1)"); }
    return 0.5 * ln((1.0 + x) / (1.0 - x));
}


// ── Aritmética de inteiros ───────────────────────────────────

fn _fail_int(string msg) -> int ={
    throw("[cryo-math] " + msg);
}

pub fn is_even(int n) -> bool ={
    return (n & 1) == 0;
}

pub fn is_odd(int n) -> bool ={
    return (n & 1) == 1;
}

pub fn factorial(int n) -> int ={
    if (n < 0) { return _fail_int("factorial: argumento negativo"); }
    if (n > _MAX_FACTORIAL) { return _fail_int("factorial: resultado nao cabe em int (n > 20)"); }
    int result = 1;
    for (int i = 2; i <= n; i++) { result = result * i; }
    return result;
}

// n-ésimo número de Fibonacci (fib(0) = 0, fib(1) = 1).
pub fn fib(int n) -> int ={
    if (n < 0) { return _fail_int("fib: argumento negativo"); }
    if (n > 92) { return _fail_int("fib: resultado nao cabe em int (n > 92)"); }
    if (n == 0) { return 0; }
    // termina em b = fib(n) sem calcular fib(n + 1), que estouraria em n = 92
    int a = 0;
    int b = 1;
    for (int i = 1; i < n; i++) {
        int t = a + b;
        a = b;
        b = t;
    }
    return b;
}

// Máximo divisor comum (sempre >= 0).
pub fn gcd(int a, int b) -> int ={
    int x = iabs(a);
    int y = iabs(b);
    while (y != 0) {
        int t = x % y;
        x = y;
        y = t;
    }
    return x;
}

// Mínimo múltiplo comum (sempre >= 0).
pub fn lcm(int a, int b) -> int ={
    if (a == 0 || b == 0) { return 0; }
    return iabs(a / gcd(a, b) * b);
}

pub fn is_prime(int n) -> bool ={
    if (n < 2) { return false; }
    if (n < 4) { return true; }
    if (n % 2 == 0 || n % 3 == 0) { return false; }
    int i = 5;
    while (i <= n / i) {
        if (n % i == 0 || n % (i + 2) == 0) { return false; }
        i = i + 6;
    }
    return true;
}

// Fatores primos de n em ordem crescente (com repetição).
pub fn prime_factors(int n) -> int[] ={
    int[] out = [];
    int x = iabs(n);
    int d = 2;
    while (x > 1 && d <= x / d) {
        while (x % d == 0) {
            out.push(d);
            x = x / d;
        }
        d = d + 1;
    }
    if (x > 1) { out.push(x); }
    return out;
}

// Combinação C(n, k): de quantas formas escolher k itens de n.
pub fn binomial(int n, int k) -> int ={
    if (k < 0 || n < 0) { return _fail_int("binomial: argumentos negativos"); }
    if (k > n) { return 0; }
    int kk = k;
    if (n - k < kk) { kk = n - k; }
    int result = 1;
    for (int i = 1; i <= kk; i++) {
        // sempre exato: result * (n-kk+i) é divisível por i
        result = result * (n - kk + i) / i;
    }
    return result;
}

// Arranjo A(n, k) = n! / (n - k)!
pub fn permutations(int n, int k) -> int ={
    if (k < 0 || n < 0) { return _fail_int("permutations: argumentos negativos"); }
    if (k > n) { return 0; }
    int result = 1;
    for (int i = 0; i < k; i++) { result = result * (n - i); }
    return result;
}

// (base^exp) mod m, sem estourar para m até ~3·10^9.
pub fn mod_pow(int base, int exp, int m) -> int ={
    if (m <= 0) { return _fail_int("mod_pow: modulo deve ser positivo"); }
    if (exp < 0) { return _fail_int("mod_pow: expoente negativo"); }
    if (m == 1) { return 0; }
    int result = 1;
    int b = base % m;
    if (b < 0) { b = b + m; }
    int e = exp;
    while (e > 0) {
        if ((e & 1) == 1) { result = (result * b) % m; }
        b = (b * b) % m;
        e = e >> 1;
    }
    return result;
}


// ── Estatística (arrays de number) ───────────────────────────

fn _require_nonempty(number[] xs, string fname) -> bool ={
    if (len(xs) == 0) {
        throw("[cryo-math] " + fname + ": lista vazia");
    }
    return true;
}

pub fn sum(number[] xs) -> number ={
    // soma compensada de Kahan: menos erro de arredondamento
    number total = 0.0;
    number c = 0.0;
    for (number x in xs) {
        number y = x - c;
        number t = total + y;
        c = (t - total) - y;
        total = t;
    }
    return total;
}

pub fn product(number[] xs) -> number ={
    number p = 1.0;
    for (number x in xs) { p = p * x; }
    return p;
}

pub fn mean(number[] xs) -> number ={
    _require_nonempty(xs, "mean");
    return sum(xs) / to_number(len(xs));
}

pub fn min_of(number[] xs) -> number ={
    _require_nonempty(xs, "min_of");
    number best = xs[0];
    for (number x in xs) { if (x < best) { best = x; } }
    return best;
}

pub fn max_of(number[] xs) -> number ={
    _require_nonempty(xs, "max_of");
    number best = xs[0];
    for (number x in xs) { if (x > best) { best = x; } }
    return best;
}

// Cópia ordenada (insertion sort; não altera o array original).
pub fn sorted(number[] xs) -> number[] ={
    number[] out = [];
    for (number x in xs) { out.push(x); }
    for (int i = 1; i < len(out); i++) {
        number key = out[i];
        int j = i - 1;
        while (j >= 0 && out[j] > key) {
            out[j + 1] = out[j];
            j = j - 1;
        }
        out[j + 1] = key;
    }
    return out;
}

pub fn median(number[] xs) -> number ={
    _require_nonempty(xs, "median");
    number[] s = sorted(xs);
    int n = len(s);
    if ((n & 1) == 1) { return s[n / 2]; }
    return (s[n / 2 - 1] + s[n / 2]) / 2.0;
}

// Variância populacional.
pub fn variance(number[] xs) -> number ={
    number mu = mean(xs);
    number acc = 0.0;
    for (number x in xs) { acc = acc + (x - mu) * (x - mu); }
    return acc / to_number(len(xs));
}

// Variância amostral (divide por n - 1).
pub fn sample_variance(number[] xs) -> number ={
    if (len(xs) < 2) { return _fail("sample_variance: precisa de pelo menos 2 valores"); }
    number mu = mean(xs);
    number acc = 0.0;
    for (number x in xs) { acc = acc + (x - mu) * (x - mu); }
    return acc / to_number(len(xs) - 1);
}

pub fn std_dev(number[] xs) -> number ={
    return sqrt(variance(xs));
}

pub fn sample_std_dev(number[] xs) -> number ={
    return sqrt(sample_variance(xs));
}


// ── Porcentagem e finanças simples ───────────────────────────

// pct% de value: percent(200, 15) = 30
pub fn percent(number value, number pct) -> number ={
    return value * pct / 100.0;
}

// Quanto `part` representa de `total`, em %.
pub fn percent_of(number part, number total) -> number ={
    if (total == 0.0) { return _fail("percent_of: total zero"); }
    return part / total * 100.0;
}

// Variação percentual de `old` para `new_value`.
pub fn percent_change(number old, number new_value) -> number ={
    if (old == 0.0) { return _fail("percent_change: valor inicial zero"); }
    return (new_value - old) / abs(old) * 100.0;
}

// Juros compostos: montante após `periods` períodos à taxa `rate` (0.05 = 5%).
pub fn compound(number principal, number rate, int periods) -> number ={
    return principal * ipow(1.0 + rate, periods);
}
